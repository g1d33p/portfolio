    <worksheet name='Profitability by Discount Band'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Times New Roman'>Profitability by Discount Band</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Customers+' name='federated.0zyq5yv1fdyctm1d0ef9x1u3zwfe' />
          </datasources>
          <datasource-dependencies datasource='federated.0zyq5yv1fdyctm1d0ef9x1u3zwfe'>
            <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_308778089888329728]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
            </column>
            <column caption='Discount Band' datatype='string' name='[Calculation_308778089896570888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Discount] = 0 THEN &quot;No Discount&quot;&#10;ELSEIF [Discount] &lt;= 0.10 THEN &quot;0–10%&quot;&#10;ELSEIF [Discount] &lt;= 0.25 THEN &quot;10–25%&quot;&#10;ELSEIF [Discount] &lt;= 0.40 THEN &quot;25–40%&quot;&#10;ELSE &quot;40%+&quot;&#10;END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
